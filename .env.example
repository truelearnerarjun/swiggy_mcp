# === Google Gemini ===
# Get yours free at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# === Swiggy MCP ===
# Official Swiggy MCP Food server endpoint
SWIGGY_MCP_FOOD_URL=https://mcp.swiggy.com/food

# === OAuth Callback ===
# Local port for the OAuth redirect listener
OAUTH_REDIRECT_PORT=3000

# === Meta WhatsApp Cloud API ===
# Get these from Meta for Developers (https://developers.facebook.com)
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345
META_VERIFY_TOKEN=swiggy_agent_secret

# === (Optional) Twilio WhatsApp Integration ===
# Get these from your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Port for WhatsApp Webhook Server
PORT=3000
